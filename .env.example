# Copy to .env.local and fill in with your Supabase project's values (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser, never prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço canônico. Sem ele os links de recuperação de senha saem apontando para o host
# de onde a requisição veio, e um endereço antigo da Vercel gera link que não abre.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Pagamentos online (Stripe) — opcional; sem estas variáveis o resto funciona igual.
#
# Ficam no ambiente, e não em clinic_settings como o n8n e o WAHA, porque a chave secreta
# move dinheiro de verdade: pertence a quem tem acesso ao painel de deploy, não a quem tem
# acesso a uma tela do sistema.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Gerado pelo Stripe ao cadastrar o webhook em Developers > Webhooks, apontando para
# https://<seu-dominio>/api/integrations/stripe/webhook
STRIPE_WEBHOOK_SECRET=
